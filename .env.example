# Safety first: no broker orders while true.
DRY_RUN=true
CTRADER_ENV=demo
CTRADER_CLIENT_ID=replace_me
CTRADER_CLIENT_SECRET=replace_me
CTRADER_ACCESS_TOKEN=replace_me
CTRADER_ACCOUNT_ID=0

# IMPORTANT: exact Pepperstone cTrader symbol name returned by your account.
# Do not assume the TradingView alias WTOIL-PERP is also the broker symbol.
CTRADER_SYMBOL=replace_with_exact_pepperstone_oil_symbol
# Protocol volume is 0.01 unit. Verify this value in the Pepperstone demo account.
CTRADER_VOLUME=100
CTRADER_LABEL=TV_OIL_3_0
CTRADER_COMMENT=TradingView Oil 3.0 Optimiert

WEBHOOK_TOKEN=replace_with_a_long_random_secret
ALLOWED_STRATEGIES=OIL_2_2_OPT_MORNING_AFTERNOON_ADX
ALLOWED_SYMBOLS=WTOIL-PERP
MAX_SIGNAL_AGE_SECONDS=300
ALLOW_PYRAMIDING=false
CLOSE_ONLY_OWN_LABEL=true
REQUEST_TIMEOUT_SECONDS=10
DB_PATH=data/oil_execution.db
LOG_LEVEL=INFO
